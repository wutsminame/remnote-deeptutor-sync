{
  "name": "remnote-deeptutor-sync", "version": "0.1.1", "private": true,
  "scripts": {
    "dev": "webpack serve --mode development",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && node validate.cjs && webpack --mode production && cd dist && bestzip ../PluginZip.zip ./*",
    "build:local": "npm run typecheck && node validate.cjs --local && webpack --mode production"
  },
  "dependencies": {"@remnote/plugin-sdk": "0.0.46", "idb": "8.0.3", "react": "17.0.2", "react-dom": "17.0.2"},
  "devDependencies": {
    "@types/react": "^17.0.0", "@types/react-dom": "^17.0.0", "@types/node": "^22.0.0",
    "bestzip": "^2.2.1", "copy-webpack-plugin": "^12.0.2", "esbuild-loader": "^4.3.0",
    "html-webpack-plugin": "^5.6.3", "typescript": "^5.7.3", "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1", "webpack-dev-server": "^5.2.0", "vitest": "^3.0.8", "fake-indexeddb": "^6.0.0"
  }
}
